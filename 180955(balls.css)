/* Start http://www.cursors-4u.com */


* {
	cursor: url(http://cur.cursors-4u.net/cursors/cur-9/cur829.cur), auto !important;
}




/* End http://www.cursors-4u.com */


::-webkit-scrollbar {
	width: 8px;
	height: 0px;
}


::-webkit-scrollbar-track {
	background: white;
	border-radius: 10px;
}


::-webkit-scrollbar-thumb {
	background: #566c79;
	border-radius: 10px;
}


